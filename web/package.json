{
  "name": "chronos-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "adapter": "tsx adapter/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check adapter app e2e package.json tsconfig.json postcss.config.mjs eslint.config.mjs next.config.mjs",
    "test": "node --import tsx --test adapter/*.test.ts app/*.test.ts app/*.test.tsx",
    "test:e2e": "node --test e2e/*.test.mjs"
  },
  "dependencies": {
    "lightweight-charts": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.58.2",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
